# ===== macOS =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===== 编辑器 / IDE =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== 本地环境变量 =====
# 注意：env/env.yaml 是 teamai 的团队变量清单，必须提交到团队仓库，
# 否则 `teamai push/pull` 的 env 同步会失效（值以明文共享，仓库须为私有）。
.env
.env.*
!.env.example
env/*
!env/.gitkeep
!env/env.yaml
!env/*.example

# ===== TeamAI 本地产物 =====
.teamai/

# ===== 日志 / 临时文件 =====
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig

# ===== 依赖与构建产物 =====
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ===== Java =====
target/
*.class

# ===== 密钥（切勿提交）=====
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml
